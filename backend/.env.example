# ====== Aplikasi ======
APP_NAME="Contract Management"
# Ganti dengan string acak panjang (misal hasil: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=ganti-dengan-string-acak-yang-panjang
TOKEN_EXPIRE_HOURS=12
# Alamat frontend (dipisah koma kalau lebih dari satu)
CORS_ORIGINS=http://localhost:5173

# ====== Database ======
# SQLite (default, tanpa install apa-apa):
DATABASE_URL=sqlite:///./contract.db
# PostgreSQL (install dulu: pip install psycopg2-binary):
# DATABASE_URL=postgresql://user:password@localhost:5432/contract_db

# ====== Admin pertama (dibuat otomatis kalau belum ada admin) ======
FIRST_ADMIN_NAME="Administrator"
FIRST_ADMIN_EMAIL=admin@banktanah.id
FIRST_ADMIN_PASSWORD=Admin#12345

# ====== Reminder ======
# Kontrak dianggap "segera habis" jika sisa <= REMINDER_MONTHS bulan
REMINDER_MONTHS=3
# Jam kirim email reminder harian (zona Asia/Jakarta)
REMINDER_HOUR=8
REMINDER_MINUTE=0

# ====== Email (SMTP) ======
# Kosongkan SMTP_HOST kalau belum mau kirim email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Contract Management <noreply@banktanah.id>"
# true = STARTTLS (port 587), ssl = SSL langsung (port 465), false = tanpa enkripsi
SMTP_TLS=true

# ====== Upload ======
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
